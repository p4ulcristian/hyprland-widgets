[Unit]
Description=desktop-widget — drives, internet and devices on the desktop, below all windows
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Environment=WIDGETS_SCREEN=DP-2
Environment=WIDGETS_CORNER=top-right
ExecStart=/usr/bin/qs -c desktop-widget
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
